{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "gunicorn --worker-class eventlet --workers 1 --bind 0.0.0.0:${PORT:-5001} --timeout 120 --graceful-timeout 30 --access-logfile - wsgi:application",
    "restartPolicyType": "ON_FAILURE"
  }
}
