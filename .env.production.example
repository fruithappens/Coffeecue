# PRODUCTION ENVIRONMENT TEMPLATE
# =================================
#
# DO NOT commit real values here. This file is a TEMPLATE showing
# which variables Railway needs in its dashboard Environment section.
# Real values are pasted into Railway's Variables UI (encrypted at rest).
#
# After deploy, retrieve actual values from:
#   railway.app → your project → Variables tab
#
# Last regenerated: 2026-06-03 (deploy refresh)

# ----- Flask core -----
SECRET_KEY=__SET_IN_RAILWAY_DASHBOARD__
FLASK_ENV=production

# ----- Hardening flags (must be these values in prod) -----
DEBUG=False
TESTING_MODE=False

# ----- JWT -----
JWT_SECRET_KEY=__SET_IN_RAILWAY_DASHBOARD__
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=604800
JWT_COOKIE_SECURE=True
JWT_COOKIE_CSRF_PROTECT=True

# ----- Twilio (live SMS — real money) -----
# Paste real values into Railway dashboard, NEVER here.
TWILIO_ACCOUNT_SID=__SET_IN_RAILWAY_DASHBOARD__
TWILIO_AUTH_TOKEN=__SET_IN_RAILWAY_DASHBOARD__
TWILIO_PHONE_NUMBER=__SET_IN_RAILWAY_DASHBOARD__

# ----- CORS -----
# Comma-separated list. MUST include the Railway-provided domain AND
# any custom / shortened domain that fronts the app.
# Example:
#   CORS_ALLOWED_ORIGINS=https://coffeecue-production.up.railway.app,https://rebrand.ly/coffeecue
CORS_ALLOWED_ORIGINS=__SET_IN_RAILWAY_DASHBOARD__
CORS_SUPPORTS_CREDENTIALS=True

# ----- Database -----
# Railway PostgreSQL plugin sets DATABASE_URL automatically — don't set it here.
PG_SSL_MODE=require
DB_POOL_MIN_CONNECTIONS=1
DB_POOL_MAX_CONNECTIONS=10
PG_MAX_RETRIES=3

# ----- App settings -----
# Railway injects PORT automatically; run_server.py reads it.
LOG_LEVEL=INFO

# ----- Password policy -----
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_SPECIAL=True

# ----- Default admin (used by railway_create_admin.py on first boot) -----
# Change the password after first login via the Organiser interface.
DEFAULT_ADMIN_USERNAME=coffeecue
DEFAULT_ADMIN_EMAIL=admin@coffeecue.com
DEFAULT_ADMIN_PASSWORD=__SET_IN_RAILWAY_DASHBOARD__
