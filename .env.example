# Expresso — environment variables template
#
# Copy to .env (which is gitignored) and fill in real values. The
# defaults below are safe to use for local dev. For a Railway / cloud
# deploy, override at least DATABASE_URL, JWT_SECRET_KEY, TWILIO_*,
# and CORS_ALLOWED_ORIGINS — see comments per section.
#
# Anything not set here falls back to the defaults defined in
# config.py — this file is a discoverability aid for operators, not
# a strict allowlist.


# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Postgres URL. In dev defaults to localhost:5432/expresso for the
# current OS user. Railway provides DATABASE_URL automatically when a
# Postgres plugin is attached.
DATABASE_URL=postgresql://localhost/expresso

# Pool sizing. Defaults moved up from 1..10 to 2..30 (May 2026 audit
# batch B) so Railway containers handle a few dozen concurrent
# baristas without blocking. Tune up if you see "pool exhausted" logs.
DB_POOL_MIN_CONNECTIONS=2
DB_POOL_MAX_CONNECTIONS=30
PG_SCHEMA=public
PG_SSL_MODE=prefer
PG_MAX_RETRIES=3


# ---------------------------------------------------------------------------
# SMS — provider abstraction
# ---------------------------------------------------------------------------
# Coffee Cue supports three SMS providers via services/sms/. Twilio is
# the default. ClickSend and Cellcast are wired but disabled unless
# their env vars are set. All three can run simultaneously (each on its
# own webhook URL); SMS_PROVIDER below picks the outbound primary.
# See services/sms/README.md for the full story.

# Outbound primary. twilio | clicksend | cellcast.
SMS_PROVIDER=twilio

# Opt-in to the new provider factory in services/messaging.py.
# Default false = legacy Twilio code path runs (current production
# behaviour). Set to true once you've configured another provider and
# want SMS_PROVIDER to actually swap the outbound path.
SMS_USE_PROVIDER_FACTORY=false


# --- Twilio (default) ---
# Get these from console.twilio.com. TWILIO_PHONE_NUMBER should be in
# E.164 format (+61400000000). In production these MUST be real —
# leaving TWILIO_AUTH_TOKEN unset or as 'test_token' will be rejected
# (see routes/sms_routes.py — gated to TESTING_MODE only).
# Webhook: https://<host>/api/sms
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+15555555555


# --- ClickSend (Australian, free inbound, PAYG) ---
# Webhook: https://<host>/api/sms/clicksend
# In the ClickSend portal, add a custom header on the inbound webhook:
#   X-Coffee-Cue-Webhook-Secret: <whatever you set CLICKSEND_WEBHOOK_SECRET to>
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=
CLICKSEND_FROM_NUMBER=+61400000000
CLICKSEND_WEBHOOK_SECRET=


# --- Cellcast (Australian, cheapest at scale) ---
# Webhook: https://<host>/api/sms/cellcast
# Add custom header X-Coffee-Cue-Webhook-Secret: <CELLCAST_WEBHOOK_SECRET>.
CELLCAST_API_KEY=
CELLCAST_FROM_NUMBER=+61400000000
CELLCAST_WEBHOOK_SECRET=

# Dev/test toggle. When True, SMS isn't actually sent (the bot logs
# "TESTING MODE — Would send to: ..." instead) and a few other safety
# rails relax (demo-token bypass in auth.py, SQLite DB fallback,
# unauthenticated WebSocket connections). MUST be False in production.
TESTING_MODE=True


# ---------------------------------------------------------------------------
# SMS-side timing (added during the May 2026 SMS audit fixes)
# ---------------------------------------------------------------------------
# Idle minutes after which a customer's mid-order conversation is
# reset (so their reply tomorrow doesn't land in yesterday's milk
# question). 0 disables the timeout.
STALE_CONVERSATION_MINUTES=20

# Pickup-reminder background service. After PICKUP_REMINDER_MINUTES
# of "completed but not picked up" the customer gets one gentle
# follow-up SMS. Set to 0 to disable. The MAX_AGE cap stops a fresh
# deploy from spamming reminders for historical orders.
PICKUP_REMINDER_MINUTES=10
PICKUP_REMINDER_INTERVAL_SECONDS=60
PICKUP_REMINDER_MAX_AGE_MINUTES=240


# ---------------------------------------------------------------------------
# Authentication / JWT
# ---------------------------------------------------------------------------
# JWT signing secret. MUST be a long random string in production —
# rotating it logs out every active user. SECRET_KEY is reused as
# JWT_SECRET_KEY if the latter isn't set.
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=

# Token TTLs in seconds. 8 hours covers an event-day shift; 30 days
# of refresh covers multi-day events without forcing daily re-login.
JWT_ACCESS_TOKEN_EXPIRES=28800
JWT_REFRESH_TOKEN_EXPIRES=2592000
JWT_COOKIE_SECURE=False
JWT_COOKIE_CSRF_PROTECT=False


# ---------------------------------------------------------------------------
# Flask app
# ---------------------------------------------------------------------------
# 5001 because macOS uses 5000 for AirPlay.
PORT=5001
DEBUG=False

# Comma-separated list of allowed CORS origins. For Railway, add the
# frontend's public URL. Wildcards (https://*.railway.app) are
# supported for ephemeral preview deploys.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_SUPPORTS_CREDENTIALS=True


# ---------------------------------------------------------------------------
# Branding / event identity
# ---------------------------------------------------------------------------
# Display name on Display screens, SMS responses, etc. Operators can
# override per-event in the Branding panel (writes to settings table);
# this is just the boot-time default.
EVENT_NAME=Coffee Event


# ---------------------------------------------------------------------------
# Stations / queue tuning
# ---------------------------------------------------------------------------
NUM_STATIONS=3
MAX_QUEUE_SIZE=50
RUSH_THRESHOLD=10


# ---------------------------------------------------------------------------
# Default admin / access codes (used on first DB init)
# ---------------------------------------------------------------------------
# These are written to the users table once on initial schema setup
# and never read after. Change DEFAULT_ADMIN_PASSWORD on first login.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=coffee123
# VIP / staff codes randomize on every fresh init unless you pin them
# here. Customers text one of these to skip the queue.
DEFAULT_VIP_CODE=
DEFAULT_STAFF_CODE=


# ---------------------------------------------------------------------------
# Password policy
# ---------------------------------------------------------------------------
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_SPECIAL=True


# ---------------------------------------------------------------------------
# Loyalty (currently informational only — not wired to a redemption flow)
# ---------------------------------------------------------------------------
LOYALTY_POINTS_PER_ORDER=10
LOYALTY_POINTS_FOR_FREE_COFFEE=100
LOYALTY_BONUS_FEEDBACK=5


# ---------------------------------------------------------------------------
# Payment processing (Stripe — currently not wired into order flow)
# ---------------------------------------------------------------------------
# Honor-system pricing is the live model; the SMS confirmation tells
# customers the total and they pay at the counter on collection. These
# are reserved for a future card-on-file flow.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=


# ---------------------------------------------------------------------------
# Email (used for password reset; off by default)
# ---------------------------------------------------------------------------
EMAIL_ENABLED=False
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=noreply@example.com


# ---------------------------------------------------------------------------
# Frontend (Create React App reads these at build time)
# ---------------------------------------------------------------------------
# Override the backend URL the React dev-server proxies to. Used by
# Barista Front End/src/setupProxy.js — if unset, defaults to
# http://localhost:5001. Useful when running `npm start` against a
# remote backend (Railway preview, staging, etc).
# REACT_APP_API_URL=https://your-backend.up.railway.app
